# ============================================================================
# NV色心实验系统 - 时序约束文件（M4 PS集成版）
# ============================================================================
# 【负责智能体】@H 硬件工程师
# 【开发阶段】M4.0.1 PS系统集成
# ============================================================================
# 【变更说明】
#   - 移除sys_clk_50m外部时钟定义（改用PS7 FCLK_CLK0）
#   - 新增FCLK_CLK0时钟定义（由PS7生成，50MHz）
#   - ADC时钟保持不变（异步时钟域）
# ============================================================================

# ============================================================================
# 1. 时钟定义
# ============================================================================

# PS7 FCLK_CLK0 = 50MHz（PL端主时钟，由PS7生成）
# 注意：此约束需在Block Design生成后，根据实际网络名调整
# Vivado Block Design会自动创建FCLK_CLK0约束，此处作为备份
# create_clock -period 20.000 -name FCLK_CLK0 [get_pins ps7/FCLK_CLK0]

# ADC外部时钟 = 10MHz（异步时钟域）
create_clock -period 100.000 -name adc_clk_in [get_ports adc_clk_in]

# ============================================================================
# 2. 时钟分组（异步时钟域）
# ============================================================================

set_clock_groups -asynchronous \
    -group [get_clocks -include_generated_clocks [get_pins -hierarchical -filter {NAME =~ */ps7/FCLK_CLK0}]] \
    -group [get_clocks adc_clk_in]

# ============================================================================
# 3. 虚假路径
# ============================================================================

set_false_path -to [get_ports {led[*]}]
set_false_path -from [get_ports {key[*]}]
